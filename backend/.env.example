# Uvicorn reads these from the shell, not automatically from this file.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000
# Public aliases only; never use a personal hostname or account name.
INFRAWATCH_HOST_ID=local
INFRAWATCH_HOST_LABEL="Local system"
# Single local filesystem target (server-side configuration, never an API parameter).
INFRAWATCH_DISK_PATH=/
# Stage 2A is opt-in. No database connection during app startup or health/metrics.
INFRAWATCH_DB_ENABLED=0
# Provide a private postgresql+psycopg URL through the shell; never use VITE_.
INFRAWATCH_DATABASE_URL=
# Dedicated test environment ONLY. Do not point these at a user/development DB.
INFRAWATCH_TEST_DB_CONFIRM=
INFRAWATCH_TEST_DATABASE_URL=
INFRAWATCH_TEST_APP_DATABASE_URL=
INFRAWATCH_TEST_REGISTER_DATABASE_URL=
